# PostgreSQL / Supabase connection string (used by src/db/index.ts on Vercel / Node)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Secret key for HMAC-SHA256 authentication session tokens (set a strong random string in Vercel)
AUTH_SECRET="replace-with-strong-random-32-byte-secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
