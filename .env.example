# PostgreSQL / Supabase IPv4 Pooler connection string (required on Vercel IPv4 runtimes)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Secret key for HMAC-SHA256 authentication session tokens (set a strong random string in Vercel)
AUTH_SECRET="replace-with-strong-random-32-byte-secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
